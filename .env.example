# ============================================================
# EduFree.AI - Environment Template
# Copy this file to .env and insert your own credentials
# ============================================================

# Google Gemini API Key (Get a free key at https://aistudio.google.com)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Real-time Database (https://supabase.com — free tier available)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
